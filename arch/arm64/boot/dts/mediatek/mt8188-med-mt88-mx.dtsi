// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Libre Computer MED-MT88-MX (MT8188-die SODIMM SOM) -- board half shared by
 * the two SKUs, which are the same PCB with a different eFuse:
 *   MED-MT88-MX-G5 = MT8370  (mt8370-med-mt88-mx-g5.dts, includes mt8370.dtsi)
 *   MED-MT88-MX-G7 = MT8390  (mt8390-med-mt88-mx-g7.dts, includes mt8188.dtsi,
 *                             as mt8390-genio-700-evk.dts does: MT8390 is the
 *                             full MT8188 die, no SoC dtsi of its own)
 * The board .dts includes the SoC dtsi, then this file, and sets only /model
 * and /compatible. Nothing below is SoC-specific: the fused-out G5 cores and
 * GPU core live in mt8370.dtsi.
 *
 * USB map matches U-Boot L66 (024b65093b0) and the MX pinout's USB port
 * allocation:
 *   Type-C P0  = ssusb0 USB2 DRD only (no SSUSB; DP_TX on Type-C SS pins)
 *   SODIMM  P1 = ssusb1 USB3 DRD (u2port1 + u3port1)
 *   SODIMM  P2 = ssusb2 USB2 (Group C)
 *
 * mt8390-genio-common.dtsi is the MT8188 EVK PMIC/mmc/i2c skeleton. The MX is
 * not that EVK: no USB hub, no IT5205 SS/DP mux, Type-C is USB2+DP only.
 * USB nodes below are first-class MX wiring, not an EVK overlay.
 */

#include "mt8390-genio-common.dtsi"
#include "mt8188-apusys.dtsi"

/ {
	/*
	 * Placeholder only: the MX (MT8370/MT8390) BL2 detects DRAM at runtime
	 * (2/4/8 GiB assemblies, one image) and U-Boot rewrites this node from
	 * the detected size. Same value for both SKUs.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0x1 0x00000000>;
	};
};

/*
 * Memory map. The secure runtime on this board is NOT at the addresses
 * mt8390-genio-common.dtsi reserves for the MT8188 EVKs (BL31 TZRAM
 * 0x54600000, OP-TEE 0x43200000). Our TF-A fork packs it at the DRAM base:
 * plat/mediatek/mt8188/include/platform_def.h:331 TZRAM_BASE 0x40000000,
 * :332 TZRAM_SIZE 2 MiB, :344/:363 BL31_BASE = TZRAM_BASE + 0x1000,
 * :348 BL32_BASE 0x40200000, :349 BL32_LIMIT 10 MiB (master-gaema
 * 75f1e6b60 "mt8188: pack TZRAM/BL32 at DRAM base"). Inherited unchanged,
 * the DT handed Linux 4 GiB from 0x40000000 with nothing reserved below
 * 0x43200000, i.e. BL31 and OP-TEE as ordinary System RAM, and no
 * bootloader can fix it from the other side. U-Boot derives the bank from
 * its own constant, not from the DT: u-boot common/board_f.c:351-352
 * gd->ram_base = CFG_SYS_SDRAM_BASE (u-boot include/configs/mt8188.h:96 =
 * 0x40000000), :247-248 bi_dram[0].start = gd->ram_base, and at bootm
 * u-boot arch/arm/lib/bootm.c:409 -> arch/arm/lib/bootm-fdt.c:34,44-45,54
 * fdt_fixup_memory_banks() writes that start/size back into /memory. The
 * base Linux boots with is therefore 0x40000000 either way, so a
 * reserved-memory node is the only thing that can fence the secure runtime.
 * That is the configuration that made BL31 unbootable behind this BL2: the
 * EL3 image was loaded to the vendor address while its text links at ours.
 *
 * So the two inherited secure carve-outs are deleted below and replaced at
 * the addresses this board's BL31 actually occupies:
 *   0x40000000  2 MiB  BL31  (TZRAM_BASE .. BL31_LIMIT)
 *   0x40200000 12 MiB  BL32  OP-TEE: TEE_RAM 2 + TA_RAM 8 + SHMEM 2, the
 *                         same layout genio-common documents at
 *                         :83-96 for 0x43200000 -- 2 MiB wider than
 *                         BL32_LIMIT on purpose, so the SHMEM that sits
 *                         above the limit is never Linux RAM.
 * Everything else in the genio-common map stays -- SCP 0x50000000, VPU
 * 0x57000000, ADSP 0x60000000 and the DMA pools are loaded by other firmware
 * at the same addresses under both maps -- except the APU pool, which moves
 * below for the reason its own comment gives. The change is in this MX board
 * dtsi, not in the shared EVK dtsi, because the Genio EVKs do boot the vendor
 * map and must keep the inherited nodes.
 *
 * Deleting the inherited nodes is safe: nothing references them. `git grep
 * '&optee_reserved\|&bl31_secmon_reserved' linux-6.18.y-lc -- arch/arm64/boot/dts`
 * is empty; the only memory-region user in genio-common is scp_mem at
 * :1333 (the scp_cluster), and /chosen there carries only stdout-path
 * (:47-49). The bl31_secmon_reserved string the old DTB showed lives in
 * /__symbols__ -- it is generated from the label, not written by hand.
 *
 * The two copies of this file (linux
 * arch/arm64/boot/dts/mediatek/mt8188-med-mt88-mx.dtsi and u-boot
 * dts/upstream/src/arm64/mediatek/mt8188-med-mt88-mx.dtsi) are kept
 * byte-identical except for the pre-existing vcu power-domains hunk --
 * /device-tree-sync: this tree builds U-Boot's own DTB from dts/upstream/,
 * and U-Boot is the stage that fixes up /memory on its way to Linux.
 */
&{/reserved-memory} {
	/delete-node/ memory@54600000;
	/delete-node/ optee@43200000;

	/* 2 MiB for ARM Trusted Firmware (BL31) at TZRAM_BASE */
	bl31_secmon_tzram: memory@40000000 {
		no-map;
		reg = <0 0x40000000 0 0x00200000>;
	};

	/* 12 MiB for OP-TEE (BL32) at BL32_BASE, see the map comment above */
	optee_tzram_reserved: optee@40200000 {
		no-map;
		reg = <0 0x40200000 0 0x00c00000>;
	};
};

/*
 * The APU (RV33) pool is the one inherited reservation this board must not
 * keep at the EVK's address, because EL3 does not read the DT here: BL31's
 * LOAD_IMAGE handler (SiP op 28) compares the address the kernel hands it
 * against compile-time constants. master-gaema 9f2826101
 * plat/mediatek/mt8188/drivers/apusys/apusys_rv/2.0/apusys_rv.h:163-164
 * pins APUSYS_RESERVED_MEM_START 0x41800000 / APUSYS_RESERVED_MEM_SZ
 * 0x1400000 -- its own comment reads "below setting aligned dts (G5 packed
 * CMA after 10 MiB SCP)" -- and the common copy states the contract outright
 * (apusys_rv/2.0/apusys_rv_load_img.h:29-30, "Need same with
 * DTS:apusys-reserve-memory"). is_valid_pa_dram_range() (apusys_rv.c:
 * 2068-2082) is an equality test, not a bounds check, so with the inherited
 * 0x55000000 the size agreed and the base did not: the SMC answered -EINVAL,
 * mtk-apu logged "apusys_rv_loadimage_smc_call: smc call 28 return
 * error(-22)", the driver's probe failed with -22 and MDLA never appeared.
 *
 * 0x41800000 is free on this board, three ways: the secure carve-outs above
 * end at 0x40E00000, the next inherited reservation starts at 0x50000000, and
 * U-Boot's own lmb already holds [0x41800000-0x43ffffff] no-overwrite, so the
 * BL33 never allocates there and Linux stops doing so once this node exists.
 * The size stays 20 MB and the node keeps no no-map, exactly as inherited --
 * the APU maps it itself through apusys_rv's dma-ranges, and BL31 requires
 * 0 < apusys_img_size < res_mem_size with img/sec_info/sec_mem/coredump packed
 * inside it (apusys_rv.c:3075-3105).
 */
&{/reserved-memory} {
	/delete-node/ memory@55000000;

	/* 20 MB for the APU RV33 firmware, where BL31's op-28 gate reads it */
	apu_mem: memory@41800000 {
		compatible = "shared-dma-pool";
		reg = <0 0x41800000 0 0x01400000>;	/* 20 MB */
	};
};

&{/chosen} {
	/* where the EL3 runtime lives, named where a reader looks for it */
	bl31_secmon_reserved = "/reserved-memory/memory@40000000";
};

&auxadc {
	/*
	 * The board wires AUXIN0 to a thermistor and AUXIN1 to a board-ID divider
	 * (MED-MT88-MX schematic V0.1, the AUXIN block of the SoC sheet).
	 */
	status = "okay";
};

&mmc0 {
	/*
	 * Run the eMMC at HS400 Enhanced Strobe. The fitted chip (Sandisk DG4064)
	 * supports it (EXT_CSD STROBE_SUPPORT[184]=0x01, verified). ES is
	 * self-aligning: the device drives the data strobe with the data, so the
	 * host skips the plain-HS400 DS-delay eye search
	 * (msdc_execute_hs400_tuning). That search is marginal on this board with
	 * the genio-common hs400-ds-delay-only config -- it intermittently fails
	 * cold with "Failed to get DLY1 delay" -> "error -5 whilst initialising
	 * MMC card". ES avoids it entirely (matches our u-boot, which runs ES, and
	 * the mt8188-geralt Chromebook). Genio-510-specific override -- not in the
	 * shared mt8390-genio-common.dtsi (genio-700/1200 use that too, untested).
	 */
	mmc-hs400-enhanced-strobe;
};

/*
 * Genio-510 uses HDMI, not DisplayPort. The shared mt8390-genio-common.dtsi
 * defines merge5_out -> dpi1_in (HDMI) but then redefines it -> dp_intf1_in
 * (DisplayPort) later in the same file, which wins by include order and leaves
 * the HDMI pipeline (vdosys1 -> ethdr0 -> merge5 -> dpi1 -> hdmi) with no
 * scanout. Re-point merge5_out at dpi1 here (board dts, included last).
 */
&merge5_out {
	remote-endpoint = <&dpi1_in>;
};

/*
 * Genio-510 has no DisplayPort output -- only HDMI. mt8390-genio-common.dtsi
 * enables dp_intf1 + dp_tx and wires them into the vdosys1 of-graph (for the
 * MT8390 EVK's USB-C DP-altmode). dp_intf1's mediatek-dpi probe defers forever
 * ("Failed to get bridge" -- dp_tx provides no bridge on this board), and because
 * mtk_drm_of_ddp_path_build walks the of-graph, the never-binding dp_intf1 is a
 * required component of the vdosys1 DRM master, which therefore never completes
 * component_master_bind -> no HDMI CRTC -> no mediatek KMS card (modetest sees
 * only panfrost: "not a KMS device"). Re-pointing merge5_out -> dpi1 (above) is
 * necessary but not sufficient; we must also remove dp_intf1/dp_tx from the graph.
 * Disable both so the vdosys1 master binds with the HDMI path only.
 */
&dp_intf1 {
	status = "disabled";
};

&dp_tx {
	status = "disabled";
};

/*
 * Genio-510 is HDMI-only with no physical MIPI-DSI panel. mt8390-genio-common.dtsi
 * enables &disp_dsi0 + a startek,kd070fhfid078 panel for the MT8390 EVK. On the 510
 * the vdosys0 DRM master (the PRIMARY that calls drm_dev_register for the single
 * shared mtk drm_device) never completes -- its dsi/panel component never registers
 * (device_component: mediatek-drm.5.auto "not bound", one component "not
 * registered") -- so NO mediatek KMS card appears even though the vdosys1/HDMI
 * master is bound. Disable disp_dsi0 so vdosys0 drops out and HDMI owns the device.
 */
&disp_dsi0 {
	status = "disabled";
};

/*
 * VCU (vendor Genio) codec path selected. The mainline SCP-path mtk-vcodec
 * (mt8188-vcodec-dec/enc) and the vendor VCU nodes below both claim
 * 0x18000000 / 0x1a020000, so exactly ONE set may be "okay" -- the loser gets
 * -EBUSY on the register banks. Mainline+SCP was measured on 2026-08-29 and
 * walls at the SCP codec IPI (scp ipi 14/4 ack time out), so the mainline
 * nodes are disabled here and the VCU/vpud path (proven on MT8188 Genio-510,
 * 2026-06-25) is enabled instead. Do not enable display CRTC (&disp_dsi0 /
 * DP / HDMI).
 */
&video_decoder {
	status = "disabled";
};

&video_encoder {
	status = "disabled";
};

&{/soc} {
	vcu: vcu@18000000 {
		compatible = "mediatek,mt8395-vcu";
		status = "okay";
		mediatek,vcuid = <0>;
		mediatek,vcuname = "vcu";
		mediatek,vcu-off = <0>;
		reg = <0 0x18000000 0 0x40000>,		/* VDEC_BASE */
		      <0 0x1a020000 0 0x10000>;		/* VENC_BASE */

		/* held while /dev/vcu is open: vpud maps the banks above */
		power-domains = <&spm MT8188_POWER_DOMAIN_VDEC0>,
				<&spm MT8188_POWER_DOMAIN_VDEC1>,
				<&spm MT8188_POWER_DOMAIN_VENC>;
		power-domain-names = "vdec0", "vdec1", "venc";

		iommus = <&vdo_iommu M4U_PORT_L19_VENC_RD_COMV>;

		mediatek,mailbox-gce = <&gce1>;
		mediatek,dec_gce_th_num = <1>;
		mediatek,enc_gce_th_num = <1>;

		mboxes = <&gce1 16 CMDQ_THR_PRIO_1>,
			 <&gce1 17 CMDQ_THR_PRIO_1>;

		gce-event-names = "venc_eof",
				  "venc_wp_2nd_done",
				  "venc_wp_3nd_done";

		gce-events = <CMDQ_EVENT_VENC_TOP_VENC_FRAME_DONE>,
			     <CMDQ_EVENT_VENC_TOP_WP_2ND_STAGE_DONE>,
			     <CMDQ_EVENT_VENC_TOP_WP_3RD_STAGE_DONE>;

		/* GCE_GPR_R10 / GCE_GPR_R11 (gce/mt8195-gce.h: 0xa / 0xb) */
		gce-gpr = <0xa>, <0xb>;
	};

	vdec: vdec@18000000 {
		compatible = "mediatek,mt8395-vcodec-dec";
		status = "okay";
		mediatek,platform = "platform:mt8188";
		mediatek,ipm = <2>;
		reg = <0 0x18000000 0 0x800>,		/* VDEC_BASE */
		      <0 0x18020000 0 0x1000>,		/* VDEC_VLD */
		      <0 0x18025000 0 0x1000>,		/* VDEC_MISC */
		      <0 0x18010000 0 0x800>,		/* VDEC_LAT_MISC */
		      <0 0x18004000 0 0x1000>,		/* VDEC_RACING_CTRL */
		      <0 0x1800f000 0 0x800>,		/* VDEC_SOC_GCON */
		      <0 0x18010800 0 0x800>,		/* VDEC_LAT_WDMA */
		      <0 0x18001000 0 0x1000>,		/* VDEC_LAT_TOP */
		      <0 0x18000800 0 0x800>;		/* VDEC_UFO_ENC */
		reg-names = "VDEC_BASE",
			    "VDEC_VLD",
			    "VDEC_MISC",
			    "VDEC_LAT_MISC",
			    "VDEC_RACING_CTRL",
			    "VDEC_SOC_GCON",
			    "VDEC_LAT_WDMA",
			    "VDEC_LAT_TOP",
			    "VDEC_UFO_ENC";

		iommus = <&vdo_iommu M4U_PORT_L19_VENC_RD_COMV>;
		power-domains = <&spm MT8188_POWER_DOMAIN_VDEC0>;	/* SOC */
		interrupts = <GIC_SPI 707 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 708 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 710 IRQ_TYPE_LEVEL_HIGH 0>;

		clocks = <&vdecsys_soc CLK_VDEC1_SOC_LARB1>,
			 <&vdecsys_soc CLK_VDEC1_SOC_LAT>,
			 <&vdecsys_soc CLK_VDEC1_SOC_VDEC>,
			 <&vdecsys CLK_VDEC2_LARB1>,
			 <&vdecsys CLK_VDEC2_VDEC>;
		clock-names = "SOC_MT_CG_LARB1",
			      "LAT_MT_CG_VDEC",
			      "SOC_MT_CG_VDEC",
			      "CORE_MT_CG_LARB1",
			      "CORE_MT_CG_VDEC";

		assigned-clocks = <&topckgen CLK_TOP_VDEC>;
		assigned-clock-parents = <&apmixedsys CLK_APMIXED_TVDPLL2>;
		mediatek,vcu = <&vcu>;
	};

	venc@1a020000 {
		compatible = "mediatek,mt8395-vcodec-enc";
		status = "okay";
		mediatek,platform = "platform:mt8188";
		mediatek,ipm = <2>;
		reg = <0 0x1a020000 0 0x10000>;		/* VENC_C0 */
		reg-names = "VENC_SYS";
		iommus = <&vdo_iommu M4U_PORT_L19_VENC_RD_COMV>;
		interrupts = <GIC_SPI 353 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&vencsys CLK_VENC1_VENC>;
		clock-names = "MT_CG_VENC0";
		assigned-clocks = <&topckgen CLK_TOP_VENC>;
		assigned-clock-parents = <&topckgen CLK_TOP_UNIVPLL_D4>;
		mediatek,vcu = <&vcu>;
		port-arg-num = <3>;
		port-def = <0 M4U_PORT_L19_VENC_RCPU 0>,
			   <0 M4U_PORT_L19_VENC_REC 0>,
			   <0 M4U_PORT_L19_VENC_BSDMA 0>,
			   <0 M4U_PORT_L19_VENC_SV_COMV 0>,
			   <0 M4U_PORT_L19_VENC_RD_COMV 0>,
			   <0 M4U_PORT_L19_VENC_NBM_RDMA 1>,
			   <0 M4U_PORT_L19_VENC_NBM_RDMA_LITE 1>,
			   <0 M4U_PORT_L19_VENC_SUB_W_LUMA 0>,
			   <0 M4U_PORT_L19_VENC_FCS_NBM_RDMA 1>,
			   <0 M4U_PORT_L19_VENC_NBM_WDMA 1>,
			   <0 M4U_PORT_L19_VENC_NBM_WDMA_LITE 1>,
			   <0 M4U_PORT_L19_VENC_FCS_NBM_WDMA 1>,
			   <0 M4U_PORT_L19_VENC_CUR_LUMA 0>,
			   <0 M4U_PORT_L19_VENC_CUR_CHROMA 0>,
			   <0 M4U_PORT_L19_VENC_REF_LUMA 0>,
			   <0 M4U_PORT_L19_VENC_REF_CHROMA 0>,
			   <0 M4U_PORT_L19_VENC_SUB_R_LUMA 0>;
	};

	venc_l19 {
		compatible = "mediatek,mt8188-venc-larb";
		mediatek,larb-id = <19>;
		mediatek,hw-id = <0>;
		power-domains = <&spm MT8188_POWER_DOMAIN_VENC>;
		iommus = <&vdo_iommu M4U_PORT_L19_VENC_RCPU>,
			 <&vdo_iommu M4U_PORT_L19_VENC_REC>,
			 <&vdo_iommu M4U_PORT_L19_VENC_BSDMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_SV_COMV>,
			 <&vdo_iommu M4U_PORT_L19_VENC_RD_COMV>,
			 <&vdo_iommu M4U_PORT_L19_VENC_NBM_RDMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_NBM_RDMA_LITE>,
			 <&vdo_iommu M4U_PORT_L19_VENC_SUB_W_LUMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_FCS_NBM_RDMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_NBM_WDMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_NBM_WDMA_LITE>,
			 <&vdo_iommu M4U_PORT_L19_VENC_FCS_NBM_WDMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_CUR_LUMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_CUR_CHROMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_REF_LUMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_REF_CHROMA>,
			 <&vdo_iommu M4U_PORT_L19_VENC_SUB_R_LUMA>;
	};

	vdec_l21 {
		compatible = "mediatek,mt8188-vcodec-larb";
		mediatek,larb-id = <21>;
		mediatek,hw-id = <0>;
		power-domains = <&spm MT8188_POWER_DOMAIN_VDEC1>;	/* core0 */
		iommus = <&vdo_iommu M4U_PORT_L21_HW_VDEC_MC_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_UFO_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_PP_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_PRED_RD_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_PRED_WR_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_PPWRAP_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_TILE_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_VLD_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_VLD2_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_AVC_MV_EXT>,
			 <&vdo_iommu M4U_PORT_L21_HW_VDEC_UFO_EXT_C>;
	};

	vdec_l23 {
		compatible = "mediatek,mt8188-vcodec-larb";
		mediatek,larb-id = <23>;
		mediatek,hw-id = <1>;
		power-domains = <&spm MT8188_POWER_DOMAIN_VDEC0>;	/* soc */
		iommus = <&vpp_iommu M4U_PORT_L23_HW_VDEC_LAT0_VLD_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_LAT0_VLD2_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_LAT0_AVC_MV_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_LAT0_PRED_RD_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_LAT0_TILE_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_LAT0_WDMA_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_UFO_ENC_EXT>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_UFO_ENC_EXT_C>,
			 <&vpp_iommu M4U_PORT_L23_HW_VDEC_MC_EXT_C>;
	};
};

/*
 * USB — MED-MT88-MX (not the Genio-510/700 EVK).
 *
 * Type-C P0: USB2 DRD on ssusb0 (u2port0). No U3 PHY on this port
 * (u3p-dis-msk). Gadget KEEP is HS 480 on Plugable 3-2.1.3.3.
 *
 * SODIMM P1: USB3 DRD on ssusb1 (u2port1+u3port1). dr_mode=otg so
 * mtu3 registers the child xhci1 platform device. No EVK USB hub.
 * usb-role-switch is the EVK Type-C mux; drop it so P1 is not bound
 * to the on-board Type-C. of-graph labels stay so genio-common
 * rt1715 remote-endpoints still resolve (dtc); they do not switch P1.
 *
 * SODIMM P2: USB2 host on ssusb2 (u2port2). Not the EVK M.2/RPi OTG
 * header — no ID GPIO connector.
 */
&ssusb0 {
	dr_mode = "otg";
	maximum-speed = "high-speed";
	mediatek,u3p-dis-msk = <1>;
};

&ssusb1 {
	dr_mode = "otg";
	maximum-speed = "super-speed";
	/delete-property/ usb-role-switch;
};

&xhci1 {
	status = "okay";
	/delete-node/ hub@1;
	/delete-node/ hub@2;
};

&ssusb2 {
	dr_mode = "host";
	maximum-speed = "high-speed";
	/delete-property/ usb-role-switch;
	/delete-node/ connector;
};

/*
 * Common dtsi wires xhci2 vbus-supply to EVK Wi-Fi 3V3 (sdio_fixed_3v3).
 * MX SODIMM P2 is not that rail; the LDO is already on → EALREADY.
 */
&xhci2 {
	/delete-property/ vbus-supply;
};

/*
 * &sound { model } is the ALSA card name and carries the SKU (g5 / g7), so
 * each board .dts sets it -- not mt8390-evk from mt8390-genio-common.dtsi.
 * Keep mediatek,mt8188-mt6359-evb (mt8188-mt6359 machine driver).
 * SOF tplg stays sof-mt8188.tplg (mt8188 SOF desc, not this model).
 */

/* SCP core0 (RV32 EC lineage): enable for the open firmware stack.
 * firmware-name pins the rproc loader to the staged image; the deb
 * images ship the vendor blob under this name and the G5 open-SCP
 * DRAM-boot FIT stages the chromeos-ec-built image under it too.
 */
&scp_cluster {
	status = "okay";
};

&scp_c0 {
	status = "okay";
	firmware-name = "mediatek/mt8188/scp.img";

	/*
	 * Same node kukui, corsola, asurada and cherry use. mtk_rpmsg
	 * matches the firmware name-service announce to mediatek,rpmsg-name
	 * and attaches this OF node, so the upstream google,cros-ec-rpmsg
	 * driver binds. Geralt stays on google,cros-ec-spi and does not
	 * include this dtsi.
	 */
	cros-ec-rpmsg {
		compatible = "google,cros-ec-rpmsg";
		mediatek,rpmsg-name = "cros-ec-rpmsg";
	};
};
