# OPT-IN certification fragment: build with LB_LINUX_CLASS=aosp-certified.
# The DEFAULT AOSP build needs NOTHING from this file — the readiness pins
# live in the shared arch/arm64/configs/defconfig (K2, 799c0faf49ef9; row K3
# of the readiness merge plan).
#
# These are only the certification deltas that neither the defconfig nor any
# module could satisfy, transcribed from an internal audit
# ("Android requirements the AOSP build still misses") against the newest
# populated list, b/android-6.12/android-tv-base.config — A17's 6.18 config
# files are empty stubs. UNVERIFIED for 6.18: every line is a required-value
# claim from the 6.12 matrix, not a 6.18 test result.
#
# 🔴 NEVER deploy this class to an NFS-root board or a Debian fleet board:
# CONFIG_NFS_FS and CONFIG_FHANDLE are turned OFF below, which kills NFS
# root and any systemd-namespace user. DRAM/loop-boot benches only.
#
# Skipped by design: the CFI/LLVM lines (toolchain-derived, not config lines)
# and the symbols with no Kconfig in 6.18 (ASHMEM, QUOTA2, …). UID_SYS_STATS
# is ported (drivers/misc/uid_sys_stats.c) and pinned in the shared defconfig.

# --- must be OFF (tv-base:5/6/7/9/10/11/12/14) ---
# CONFIG_DEVMEM is not set
# CONFIG_FHANDLE is not set
# CONFIG_FW_CACHE is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
# CONFIG_NFSD is not set
# CONFIG_NFS_FS is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_SYSVIPC is not set

# --- must be built-in (=y) — audit rows marked 🔴 ---
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_MODVERSIONS=y
CONFIG_NO_HZ=y
CONFIG_KFENCE=y
CONFIG_CRYPTO_NULL=y
CONFIG_IFB=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y

# --- required y, currently =m in the defconfig (audit rows marked 🟡) ---
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_XCBC=y
CONFIG_DUMMY=y
CONFIG_VETH=y
CONFIG_UHID=y
CONFIG_USB_CONFIGFS=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_SONY=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_INET_UDP_DIAG=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_VTI=y
CONFIG_NET_IPVTI=y
CONFIG_NET_KEY=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y

# --- =y-dependency parents the two rows above need in 6.18 (not on the
# 6.12 matrix itself): IFB depends on NET_ACT_MIRRED || NFT_FWD_NETDEV
# (drivers/net/Kconfig), HID_PLAYSTATION depends on LEDS_CLASS_MULTICOLOR
# (drivers/hid/Kconfig); both default off/modular, so without these the
# required rows resolve =m and checkConfig refuses the build.
CONFIG_NET_ACT_MIRRED=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
